{
  "properties": {
    "displayName": "Disable shared key authorization",
    "description": "Portfolio guardrail for disable shared key authorization. Illustrative mapping: IA-2 / AC-3.",
    "mode": "All",
    "metadata": {
      "category": "Security",
      "version": "1.0.0",
      "controlReference": "IA-2 / AC-3"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit before considering enforcement."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "field": "Microsoft.Storage/storageAccounts/allowSharedKeyAccess",
            "notEquals": false
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
