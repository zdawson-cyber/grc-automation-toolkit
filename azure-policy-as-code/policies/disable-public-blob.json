{
  "properties": {
    "displayName": "Disable anonymous blob public access",
    "description": "Portfolio guardrail for disable anonymous blob public access. Illustrative mapping: AC-3.",
    "mode": "All",
    "metadata": {
      "category": "Security",
      "version": "1.0.0",
      "controlReference": "AC-3"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit before considering enforcement."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "field": "Microsoft.Storage/storageAccounts/allowBlobPublicAccess",
            "notEquals": false
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
